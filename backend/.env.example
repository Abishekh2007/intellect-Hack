# ============================================================
# DataPilot AI - configuration
# Copy to `.env` and fill in any LLM keys you have.
# ALL fields are optional. With no keys, the app runs fully
# offline using a template-driven engine that still answers
# real data questions and generates real SQL.
# ============================================================

# --- Database ---
# Path to the SQLite database (relative to this file). Leave default
# for the bundled demo dataset; upload your own CSV/XLSX/PDF/DOCX via
# the API or point this at an existing .db file.
DB_PATH=data/ecommerce.db
MAX_QUERY_ROWS=500
HARD_ROW_CEILING=1000

# --- LLM providers (set ANY ONE or ALL; failover picks them) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Rate limiting ---
LLM_RPM=10

# --- Sessions ---
SESSION_TTL_SECONDS=86400
MAX_HISTORY_TURNS=6
